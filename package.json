{
  "name": "AqarChat",
  "version": "2.2.0",
  "description": "Enterprise Real Estate WhatsApp Ingestion, Valuation & Inventory Engine",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "audit:schema": "node scripts/audit-db-schema.js",
    "test:pipeline": "node --env-file=.env tests/test_search_pipeline.js",
    "test:search:db": "node --env-file=.env tests/test_search_db.js",
    "schema:export": "node --env-file=.env scripts/export-schema.js",
    "eval:ai": "node --env-file=.env scripts/eval-ai.js",
    "test:unit": "node --test tests/e2e.test.js",
    "test:contracts": "jest tests/contract-guard.test.js --runInBand",
    "test:safeguards": "jest tests/safeguards.test.js --runInBand",
    "test:router": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/router --runInBand",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "npm run test:unit && npm run test:jest",
    "test": "npm run audit:schema && npm run test:pipeline && npm run test:ci"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/e2e.test.js"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "*",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.45.0",
    "axios": "*",
    "dotenv": "*",
    "exceljs": "^4.4.0",
    "express": "*",
    "html-react-parser": "^5.1.18",
    "pg": "^8.12.0",
    "satori": "^0.10.14",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
